{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clew",
  "version": "0.1.0",
  "identifier": "tech.cyanflow.clew",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://127.0.0.1:1755"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clew",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#14171c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
